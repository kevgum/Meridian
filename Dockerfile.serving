FROM python:3.11-slim

WORKDIR /app

# Install torch (CPU-only) for ONNX conversion + onnxruntime for serving.
#
# PyTorch's own CPU wheel index (download.pytorch.org/whl/cpu) only publishes
# x86_64 builds — installing from it on ARM (e.g. Oracle Cloud's free Ampere
# A1 shape) fails with "no matching distribution found". The plain PyPI index
# does carry CPU-only aarch64 wheels for torch (no CUDA variant exists for
# aarch64 via pip regardless, so there is nothing to accidentally pull in),
# so the fix is to only pin the x86-only index on x86.
RUN ARCH="$(uname -m)" && \
    if [ "$ARCH" = "x86_64" ]; then \
        pip install --no-cache-dir torch==2.3.0+cpu \
            --index-url https://download.pytorch.org/whl/cpu; \
    else \
        pip install --no-cache-dir torch==2.3.0; \
    fi && \
    pip install --no-cache-dir \
    onnx==1.16.1 \
    onnxruntime==1.18.0 \
    fastapi==0.111.0 \
    "uvicorn[standard]==0.29.0" \
    numpy==1.26.4 \
    pydantic==2.7.1 \
    pyyaml==6.0.1

# Copy source needed for conversion and serving
COPY src/models/lstm_model.py /app/lstm_model.py
COPY config/model_config.yaml /app/model_config.yaml
COPY src/serving/app.py /app/app.py
COPY docker/convert_to_onnx.py /app/convert_to_onnx.py

# Model checkpoint is mounted at /checkpoint/lstm_checkpoint_best.pt
# ONNX output goes to /models/lstm_fraud_detector.onnx
ENV MODEL_PATH=/models/lstm_fraud_detector.onnx
ENV CHECKPOINT_PATH=/checkpoint/lstm_checkpoint_best.pt
ENV DECISION_THRESHOLD=0.90

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/v1/models/lstm')"

# UVICORN_ROOT_PATH tells FastAPI what prefix it's reverse-proxied under, so
# the generated OpenAPI spec declares a "servers" entry and Swagger UI's
# "Try it out" calls the prefixed path instead of the domain root. Empty by
# default (local/dev, served at the root); the production compose file sets
# it to /model to match deploy/Caddyfile's route. This only affects URL
# generation in docs/openapi.json — Caddy's own uri strip_prefix already
# handles the actual request routing regardless of this setting.
ENV UVICORN_ROOT_PATH=

# Convert .pt → .onnx at startup if ONNX not already present, then serve
CMD ["sh", "-c", "python convert_to_onnx.py && uvicorn app:app --host 0.0.0.0 --port 8080 --root-path \"$UVICORN_ROOT_PATH\""]
