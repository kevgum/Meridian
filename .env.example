# ---------------------------------------------------------------
# Copy this file to .env and fill in values before running.
# Never commit .env — it is gitignored.
# ---------------------------------------------------------------

# Elasticsearch + Kibana password (elastic superuser)
# Used by all Elastic stack services and bootstrap_rbac.py
ELASTIC_PASSWORD=change_me_before_running

# Elasticsearch host URL
# Inside Docker network: http://elasticsearch:9200
# From the host machine: http://localhost:9200
# With TLS enabled (after running scripts/generate_certs.sh): https://localhost:9200
ELASTIC_HOST=http://localhost:9200

# Scoped API key for the feature-engineering service
# Generated by: python scripts/bootstrap_rbac.py
# Copy the ELASTIC_API_KEY value printed at the end of bootstrap output.
# Leave empty to fall back to ELASTIC_PASSWORD basic auth.
ELASTIC_API_KEY=

# Application environment
NODE_ENV=development

# Feature engineering pipeline batch size
BATCH_SIZE=512

# LSTM Inference API base URL
# Inside Docker network use: http://lstm-serving:8080
# From the host machine use: http://localhost:8080
LSTM_SERVING_URL=http://localhost:8080

# Fraud classification threshold (sigmoid output)
# Sequences with anomaly_probability >= this value are flagged as fraud
# Tuned in Day 5 evaluation — change only if retuning the model
DECISION_THRESHOLD=0.90
