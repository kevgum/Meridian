# ---------------------------------------------------------------
# Copy this file to .env and fill in values before running.
# Never commit .env — it is gitignored.
# ---------------------------------------------------------------

# Elasticsearch password (elastic superuser)
# Used by all Elastic stack services and bootstrap_rbac.py
#
# ⚠️  MUST be set before the first `docker compose up`. Elasticsearch seeds the
#     elastic superuser from this value on initial cluster formation, so leaving
#     the placeholder here makes it the real cluster password. start.sh and
#     start.ps1 refuse to run until it is changed.
#
#     Generate one with:
#       python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(28)))"
ELASTIC_PASSWORD=change_me_before_running

# Elasticsearch host URL
# Inside Docker network: http://elasticsearch:9200
# From the host machine: http://localhost:9200
# With TLS enabled (after running scripts/generate_certs.sh): https://localhost:9200
ELASTIC_HOST=http://localhost:9200

# Scoped API key for the feature-engineering service
# Generated by: python scripts/bootstrap_rbac.py
# Copy the ELASTIC_API_KEY value printed at the end of bootstrap output.
# Leave empty to fall back to ELASTIC_PASSWORD basic auth.
ELASTIC_API_KEY=

# Kibana service account token — REQUIRED for Kibana to start.
# Elasticsearch 8.11+ forbids the `elastic` superuser for Kibana, so Kibana
# authenticates with a service account token instead. Without this, Kibana
# starts but stays unavailable (HTTP 503) and logs:
#   "missing authentication credentials for REST request"
#
# Generated by: python scripts/bootstrap_rbac.py
# If the bootstrap reports a 409 conflict, the token already exists but its
# secret cannot be read back — delete and re-mint it:
#   curl -u "elastic:$ELASTIC_PASSWORD" -X DELETE \
#     "http://localhost:9200/_security/service/elastic/kibana/credential/token/kibana-token-1"
#   curl -u "elastic:$ELASTIC_PASSWORD" -X POST \
#     "http://localhost:9200/_security/service/elastic/kibana/credential/token/kibana-token-1"
# Then: docker compose up -d kibana
KIBANA_SERVICE_TOKEN=

# Application environment
NODE_ENV=development

# Feature engineering pipeline batch size
BATCH_SIZE=512

# LSTM Inference API base URL
# Inside Docker network use: http://lstm-serving:8080
# From the host machine use: http://localhost:8080
LSTM_SERVING_URL=http://localhost:8080

# Fraud classification threshold (sigmoid output)
# Sequences with anomaly_probability >= this value are flagged as fraud
# Tuned to 0.90 on the 13-feature geo-velocity retrain, AFTER fixing an
# outlier-broken MinMax range on amount_to_balance_ratio / balance_utilisation_ratio
# (src/pipeline/feature_engineering.py) — sweep selected the lowest threshold
# meeting the 98.55% accuracy target (yields 99.96% acc, 0.034% FPR, 93.5% recall,
# the first checkpoint to meet BOTH the accuracy and FPR targets)
DECISION_THRESHOLD=0.90

# Analyst webhook URL — optional
# If set, the playbook engine POSTs a JSON notification payload to this URL
# when an incident fires. Supports Microsoft Teams, Slack, PagerDuty, or any
# generic JSON endpoint. Leave empty to run in log-only mode.
# Example (Teams): https://meridian.webhook.office.com/webhookb2/...
# Example (Slack):  https://hooks.slack.com/services/...
ANALYST_WEBHOOK_URL=
