# Production environment for docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod
#   # fill in the values below, then:
#   ./deploy/init.sh          # derives ES_BASIC_AUTH from ELASTIC_PASSWORD
#
# .env.prod is gitignored. Never commit real credentials.

# --- required -----------------------------------------------------------------

# The domain pointing at this server. Caddy provisions a Let's Encrypt
# certificate for it automatically, so the DNS A record must resolve here
# BEFORE first start or certificate issuance fails.
DOMAIN=fraud.example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# Elasticsearch superuser password. Generate a strong one, e.g.
#   openssl rand -base64 24
ELASTIC_PASSWORD=

# base64("elastic:<ELASTIC_PASSWORD>") — Caddy injects this into /api requests
# so the browser never receives the password. Run ./deploy/init.sh to fill it
# in rather than computing it by hand.
ES_BASIC_AUTH=

# --- optional -----------------------------------------------------------------

# Seconds between simulated transactions. Higher values mean a calmer console
# and slower index growth.
STREAM_INTERVAL_MIN=4
STREAM_INTERVAL_MAX=12

# Model serving.
DECISION_THRESHOLD=0.90
MODEL_VERSION=1.2.0

# Kibana service account token. Leave blank on first boot, then create it with
# scripts/bootstrap_rbac.py and paste it here to enable Kibana.
KIBANA_SERVICE_TOKEN=
